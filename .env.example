# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres-superuser
YALA_APP_PASSWORD=change-me-app-role
YALA_JWT_SECRET=change-me-64-hex-chars
YALA_DATA_KEY=change-me-64-hex-chars-different-from-jwt-secret
YALA_ENV=production
# First platform administrator (temporary password; changed at first sign-in). Remove after first deploy.
YALA_BOOTSTRAP_ADMIN_EMAIL=you@example.com
YALA_BOOTSTRAP_ADMIN_PASSWORD=change-me-Temp-Passw0rd
# Synthetic demo portfolio with published passwords — only for demo instances, never with real customer data.
YALA_LOAD_DEMO=false
YALA_SHOW_DEMO_LOGIN=false
# Optional
NREL_API_KEY=
# YALA_MAP_TILE_URL=https://{s}.your-tile-provider.example/{z}/{x}/{y}.png
# YALA_MAP_TILE_ATTRIBUTION=© Your provider, © OpenStreetMap contributors
